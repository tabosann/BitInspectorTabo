<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BitInspectorTabo.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BitInspectorTabo.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
        <Style
            x:Key="SettingsPageTitleTextBlockStyle"
            BasedOn="{StaticResource TitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="1064"/>
            <Setter Property="Margin" Value="36,24,36,0"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
        </Style>
        <Style
            x:Key="SettingsPageStackPanelStyle"
            TargetType="StackPanel">
            <Setter Property="Spacing" Value="4"/>
            <Setter Property="MaxWidth" Value="1064"/>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <TextBlock
            Style="{StaticResource SettingsPageTitleTextBlockStyle}"
            x:Name="PageHeader"
            x:Uid="PageHeaderUid"/>
        <ScrollView
            Grid.Row="1"
            Padding="36,0,36,24"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Uid="SettingsLabelUid" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <toolkit:SettingsCard x:Uid="ThemeHeaderUid">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind SPVM.SelectedTheme, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="ComboBoxItemSystemUid" Tag="System" />
                        <ComboBoxItem x:Uid="ComboBoxItemLightUid" Tag="Light" />
                        <ComboBoxItem x:Uid="ComboBoxItemDarkUid" Tag="Dark" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <TextBlock x:Uid="AboutLabelUid" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <toolkit:SettingsExpander x:Uid="AboutCardUid" HeaderIcon="AllApps">
                    <TextBlock Text="1.0.2.0"/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Vertical">
                            <HyperlinkButton x:Uid="HomePageUid" NavigateUri="https://tabosann.github.io/BitInspectorTabo/"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Vertical">
                            <HyperlinkButton x:Uid="DownloadPageUid" NavigateUri="https://tabosann.github.io/BitInspectorTabo/download"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Vertical">
                            <HyperlinkButton x:Uid="AboutPageUid" NavigateUri="https://tabosann.github.io/BitInspectorTabo/about"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Vertical">
                            <HyperlinkButton x:Uid="PrivacyPolicyUid" NavigateUri="https://tabosann.github.io/BitInspectorTabo/privacypolicy"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <TextBlock x:Uid="DevLabelUid" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <toolkit:SettingsCard x:Uid="LanguageHeaderUid">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xED1E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind SPVM.SelectedLanguage, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="ComboBoxItemSystemUid" Tag="System" />
                        <ComboBoxItem x:Uid="ComboBoxItemEnglishUid" Tag="English" />
                        <ComboBoxItem x:Uid="ComboBoxItemJapaneseUid" Tag="Japanese" />
                    </ComboBox>
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
