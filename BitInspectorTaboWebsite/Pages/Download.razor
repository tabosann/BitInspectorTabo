@* Remember to replace the namespace below with your own project's namespace. *@
@namespace BitInspectorTaboWebsite.Components
@page "/download"

<PageTitle>Download</PageTitle>

<MarkdownSection FromAsset="./docs/Download.md" OnContentConverted="RefreshTableOfContents" />

@code {
    [CascadingParameter]
    public EventCallback OnRefreshTableOfContents { get; set; }

    private async Task RefreshTableOfContents()
    {
        await OnRefreshTableOfContents.InvokeAsync();
    }
}
